#!/bin/bash

set -e;

MONITORS=`c-list-connected-displays`

if [ -n "$1" ]; then
  CHOSEN_MONITOR="$1"
else
  CHOSEN_MONITOR=`echo "$MONITORS" | rofi -dmenu -p "Choose monitor: "`
fi

echo "$CHOSEN_MONITOR"

if [ -z "$CHOSEN_MONITOR" ]; then
  echo "No monitor chosen. Exiting...";
  exit 1;
fi

monitor1Params=$(c-get-xrandr-mode-rate $CHOSEN_MONITOR)
monitor1Mode=$(echo $monitor1Params | jq '.mode' --raw-output)
monitor1Rate=$(echo $monitor1Params | jq '.rate' --raw-output)

xrandr $(echo "$MONITORS" | grep -v -w "$CHOSEN_MONITOR" | xargs printf "--output %s --off ")
xrandr --output "$CHOSEN_MONITOR" --mode $monitor1Mode --rate $monitor1Rate

c-on-desktop-ready


